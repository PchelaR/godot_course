[gd_scene format=3]

[ext_resource type="Script" path="res://basics/ui/panel.gd" id="1"]
[ext_resource type="Theme" path="res://basics/ui/theme.tres" id="2"]

[node name="Panel" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2")
script = ExtResource("1")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 200
theme_override_constants/margin_top = 140
theme_override_constants/margin_right = 200
theme_override_constants/margin_bottom = 140

[node name="Box" type="VBoxContainer" parent="Margin"]
layout_mode = 2
size_flags_vertical = 4
theme_override_constants/separation = 28

[node name="Title" type="Label" parent="Margin/Box"]
layout_mode = 2
theme_override_font_sizes/font_size = 32
text = "Герой"
horizontal_alignment = 1

[node name="Health" type="HBoxContainer" parent="Margin/Box"]
layout_mode = 2
theme_override_constants/separation = 20

[node name="Label" type="Label" parent="Margin/Box/Health"]
layout_mode = 2
text = "Здоровье"

[node name="Bar" type="ProgressBar" parent="Margin/Box/Health"]
custom_minimum_size = Vector2(0, 32)
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
value = 70.0
show_percentage = false

[node name="Buttons" type="HBoxContainer" parent="Margin/Box"]
layout_mode = 2
theme_override_constants/separation = 20
alignment = 1

[node name="Hit" type="Button" parent="Margin/Box/Buttons"]
custom_minimum_size = Vector2(200, 48)
layout_mode = 2
text = "Удар −10"

[node name="Heal" type="Button" parent="Margin/Box/Buttons"]
custom_minimum_size = Vector2(200, 48)
layout_mode = 2
text = "Лечение +10"

[node name="Status" type="Label" parent="Margin/Box"]
layout_mode = 2
text = "Здоровье: 70 из 100"
horizontal_alignment = 1

[connection signal="pressed" from="Margin/Box/Buttons/Hit" to="." method="_on_hit_pressed"]
[connection signal="pressed" from="Margin/Box/Buttons/Heal" to="." method="_on_heal_pressed"]
