[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://eat.gd" id="1"]
[ext_resource type="PackedScene" path="res://maze.tscn" id="2"]
[ext_resource type="PackedScene" path="res://hero.tscn" id="3"]
[ext_resource type="PackedScene" path="res://coins.tscn" id="4"]

[node name="Level" type="Node2D"]
script = ExtResource("1")

[node name="Maze" parent="." instance=ExtResource("2")]

[node name="Coins" parent="Maze" instance=ExtResource("4")]

[node name="Hero" parent="Maze" node_paths=PackedStringArray("maze") instance=ExtResource("3")]
maze = NodePath("..")

[connection signal="cell_entered" from="Maze/Hero" to="Maze/Coins" method="eat"]
[connection signal="eaten" from="Maze/Coins" to="." method="_on_coins_eaten"]
