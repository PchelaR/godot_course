[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://waves/waves.gd" id="1_waves"]

[node name="Waves" type="Node"]
script = ExtResource("1_waves")

[node name="SpawnTimer" type="Timer" parent="."]

[node name="BreakTimer" type="Timer" parent="."]
one_shot = true

[connection signal="timeout" from="SpawnTimer" to="." method="_on_spawn_timer_timeout"]
[connection signal="timeout" from="BreakTimer" to="." method="_on_break_timer_timeout"]
